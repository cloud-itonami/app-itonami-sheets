{:paths ["src" "resources"]
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.text"}
        ;; The standalone kotoba-lang/transit repository no longer exists (GitHub
        ;; reports "not found"); transit.core now lives in the monorepo.
        io.github.kotoba-lang/transit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "91ed14c090c90ceff833a868f1685c8840503f76"
         :deps/root "lib/kotoba.transit"}
        ;; The OPC vocabulary a .xlsx is made of — content types, rels,
        ;; package. It already knew what an xlsx was: `package-kind` returns
        ;; :xlsx for an `xl/` prefix and `part-sort-key` orders
        ;; `xl/worksheets/sheetN.xml`. Zero runtime deps of its own.
        io.github.kotoba-lang/ooxml
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.ooxml"}
        ;; A pure .cljc XML parser producing hiccup. Reading a .xlsx needs
        ;; one; writing did not.
        io.github.kotoba-lang/xml
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.xml"}}
 :aliases
 {;; Bounded Kotoba profile (sheets.bounded-cells). :replace-paths/:replace-deps
  ;; so the compiler's classpath scan doesn't inherit the base :deps.
  :kotoba {:replace-paths ["src"]
           :replace-deps {io.github.kotoba-lang/amu
                          {:git/sha "f6ee539e23a967c25893361c4746746e623e8bd4"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
